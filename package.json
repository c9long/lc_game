{
  "name": "lc-game",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@10.28.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply lc-game --local",
    "db:migrate:remote": "wrangler d1 migrations apply lc-game --remote",
    "deploy": "pnpm build && wrangler deploy",
    "import:neetcode": "node scripts/import-neetcode.ts",
    "monaco": "node scripts/copy-monaco.mjs",
    "predev": "node scripts/copy-monaco.mjs && node scripts/copy-pyodide.mjs && wrangler d1 migrations apply lc-game --local",
    "prebuild": "node scripts/copy-monaco.mjs && node scripts/copy-pyodide.mjs",
    "pyodide": "node scripts/copy-pyodide.mjs",
    "tests:generate": "python3 scripts/generate-tests.py",
    "tests:verify": "python3 scripts/verify-tests.py"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260905.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "drizzle-kit": "^0.31.10",
    "pyodide": "^314.0.6",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.0"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.1",
    "drizzle-orm": "^0.45.2",
    "monaco-editor": "^0.56.0"
  }
}
